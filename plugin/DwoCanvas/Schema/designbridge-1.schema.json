{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "designbridge/1",
  "title": "DwoCanvas export",
  "description": "Tool-neutral layout export consumed by the DwoCanvas UE plugin. Colors are sRGB 0..1, sizes are design px.",
  "type": "object",
  "required": ["schema", "documents"],
  "properties": {
    "schema": { "const": "designbridge/1" },
    "source": { "type": "object", "description": "Free-form provenance (tool, file, exporter, exportedAt)." },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "data": { "type": "string", "description": "Base64 PNG / JPG." },
          "file": { "type": "string", "description": "Path relative to the JSON file (alternative to data, e.g. Photoshop slices)." },
          "scale": { "type": "number", "default": 1, "description": "Export scale (2 = @2x)." },
          "nineSlice": { "$ref": "#/$defs/sides", "description": "9-slice margins in texture px." }
        }
      }
    },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "components": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "lint": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": { "enum": ["info", "warning", "error"] },
          "node": { "type": "string" },
          "name": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "usage": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "Feature usage counts (audit)." }
  },
  "$defs": {
    "color": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 4 },
    "sides": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "left, top, right, bottom (radius: tl, tr, br, bl)." },
    "document": {
      "type": "object",
      "required": ["id", "name", "root"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["screen", "component"] },
        "target": { "type": "string", "description": "WBP package path; default <WidgetFolder>/WBP_<name>." },
        "parentClass": { "type": "string", "description": "e.g. /Script/MyGame.MyWidget; default UserWidget." },
        "preview": { "type": "string", "description": "Image id of the frame render (visual diff)." },
        "root": { "$ref": "#/$defs/node" }
      }
    },
    "paint": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["solid", "linear", "radial", "angular", "diamond", "image"] },
        "visible": { "type": "boolean" },
        "opacity": { "type": "number" },
        "color": { "$ref": "#/$defs/color" },
        "token": { "type": "string", "description": "Design variable name (ColorTokenOverrides key)." },
        "stops": { "type": "array", "items": { "type": "object", "properties": { "position": { "type": "number" }, "color": { "$ref": "#/$defs/color" } } } },
        "handles": { "type": "array", "items": { "type": "number" }, "minItems": 6, "maxItems": 6, "description": "start xy, end xy, width xy in 0..1 of the node box." },
        "image": { "type": "string" },
        "scaleMode": { "enum": ["fill", "fit", "tile", "crop"] },
        "scalingFactor": { "type": "number" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "description": "Stable node id: re-import identity." },
        "name": { "type": "string", "description": "Layer name: role prefix (btn_, list_, ...), $ = variable, _ = ignored." },
        "type": { "enum": ["frame", "group", "component", "instance", "rectangle", "ellipse", "text", "vector"] },
        "visible": { "type": "boolean" },
        "opacity": { "type": "number" },
        "rotation": { "type": "number", "description": "Degrees, counter-clockwise." },
        "clip": { "type": "boolean" },
        "box": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } }, "description": "Unrotated box relative to the parent frame." },
        "layout": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["none", "horizontal", "vertical", "wrap", "grid"] },
            "gap": { "type": "number" },
            "crossGap": { "type": "number" },
            "padding": { "$ref": "#/$defs/sides" },
            "mainAlign": { "enum": ["start", "center", "end", "space-between"] },
            "crossAlign": { "enum": ["start", "center", "end", "stretch"] },
            "columns": { "type": "integer" },
            "strokesIncluded": { "type": "boolean", "description": "Padding is measured from the stroke's inner edge (Figma strokesIncludedInLayout)" }
          }
        },
        "sizing": {
          "type": "object",
          "properties": {
            "h": { "enum": ["fixed", "hug", "fill"] },
            "v": { "enum": ["fixed", "hug", "fill"] },
            "minW": { "type": "number" }, "maxW": { "type": "number" }, "minH": { "type": "number" }, "maxH": { "type": "number" }
          }
        },
        "positioning": { "enum": ["auto", "absolute"] },
        "constraints": {
          "type": "object",
          "properties": {
            "h": { "enum": ["min", "max", "center", "stretch", "scale"] },
            "v": { "enum": ["min", "max", "center", "stretch", "scale"] }
          }
        },
        "fills": { "type": "array", "items": { "$ref": "#/$defs/paint" }, "description": "Bottom to top." },
        "stroke": {
          "type": "object",
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "width": { "type": "number" },
            "align": { "enum": ["inside", "center", "outside"] },
            "dash": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "sides": { "$ref": "#/$defs/sides" }
          }
        },
        "radius": { "type": "array", "items": { "type": "number" } },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "enum": ["drop-shadow", "inner-shadow", "background-blur", "layer-blur"] },
              "visible": { "type": "boolean" },
              "color": { "$ref": "#/$defs/color" },
              "offset": { "type": "array", "items": { "type": "number" } },
              "blur": { "type": "number" },
              "spread": { "type": "number" },
              "showBehind": { "type": "boolean", "description": "Drop shadow also shows through translucent fills (Figma showShadowBehindNode)" },
              "radius": { "type": "number" }
            }
          }
        },
        "blendMode": { "type": "string" },
        "bake": {
          "type": "object",
          "required": ["image"],
          "properties": { "image": { "type": "string" }, "overflow": { "$ref": "#/$defs/sides" } },
          "description": "Node rendered to an image by the exporter; overflow = effect area outside the box."
        },
        "text": {
          "type": "object",
          "properties": {
            "content": { "type": "string" },
            "font": { "type": "object", "properties": { "family": { "type": "string" }, "style": { "type": "string" }, "size": { "type": "number" } } },
            "color": { "$ref": "#/$defs/color" },
            "lineHeight": { "type": "object", "properties": { "unit": { "enum": ["px", "percent", "auto"] }, "value": { "type": "number" } } },
            "letterSpacing": { "type": "object", "properties": { "unit": { "enum": ["px", "percent"] }, "value": { "type": "number" } } },
            "align": { "enum": ["left", "center", "right", "justify"] },
            "valign": { "enum": ["top", "center", "bottom"] },
            "autoResize": { "enum": ["width", "height", "none", "truncate"] },
            "maxLines": { "type": "integer" },
            "case": { "enum": ["none", "upper", "lower", "title"] },
            "decoration": { "enum": ["none", "underline", "strike"] },
            "runs": { "type": "array" },
            "loc": { "type": "object", "properties": { "table": { "type": "string" }, "key": { "type": "string" } } }
          }
        },
        "component": {
          "type": "object",
          "properties": {
            "ref": { "type": "string", "description": "Component document id." },
            "name": { "type": "string" },
            "overridden": { "type": "boolean" },
            "variant": { "type": "object" }
          }
        },
        "states": {
          "type": "object",
          "description": "Button visuals per state (fills / stroke / radius / bake).",
          "properties": { "hovered": { "type": "object" }, "pressed": { "type": "object" }, "disabled": { "type": "object" } }
        },
        "meta": {
          "type": "object",
          "properties": {
            "role": { "type": "string", "description": "Role name, overrides the name prefix." },
            "variable": { "type": ["boolean", "string"] },
            "bake": { "type": "string" },
            "class": { "type": "string" }
          }
        },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
